runtime | ram: 46M | caps: 1000 | binary: init
+ requires
  + usb
  + nic         | label: nic_router
  + file_system | label: config
  + report      | label: state
  + rm

+ provides
  + nic

+ config
  + parent-provides
    + service ROM
    + service PD
    + service RM
    + service CPU
    + service LOG
    + service Timer
    + service File_system
    + service Report
    + service Usb
    + service Nic

  + default-route
    + any-service
      + parent

  + default | caps: 100

  + service Nic
    + default-policy
      + child nic_router

  + start report_rom | ram: 1M
    + provides
      + service Report
      + service ROM
    + config
      + policy | label: nic_router -> config | report: mbimcli -> nic_router.config

  + start vfs | ram: 4M
    + provides | + service File_system
    + config
    | + vfs
    |   + fs
    |   + import | + rom mbimcli.config
    | + policy | label_prefix: fs_rom | root: / | writeable: no
    + route
      + service ROM         | label: mbimcli.config | + parent | label: mbimcli_cascaded_router.config
      + service File_system                         | + parent | identity: config
      + any-service                                 | + parent

  + start fs_rom | ram: 1M
    + provides | + service ROM
    + route
      + service File_system | + child vfs
      + any-service         | + parent

  + start usb_net | caps: 200 | ram: 16M
    + provides | + service Terminal
    + config
    | + device | vendor_id: 0x12d1 | product_id: 0x15c1 | configuration: 3
    |   . MBIM config profile is 3 for Huawei ME906e, 0 lets Linux driver choose config
    + route
      + service Uplink | + child nic_router
      + any-service    | + parent

  + start nic_router | ram: 16M
    + provides
      + service Uplink
      + service Nic
    + route
      + service ROM | label: config | + child report_rom
      + service Nic                 | + parent | label: nic_router
      + any-service                 | + parent

  + start mbimcli | caps: 200 | ram: 4M
    + exit | propagate: yes
    + route
      + service ROM      | label: config            | + child fs_rom     | label: mbimcli.config
      + service Report   | label: state             | + parent           | label: state
      + service Report   | label: nic_router.config | + child report_rom
      + service Terminal                            | + child usb_net
      + any-service                                 | + parent

+ content
  + rom | label: init
  + rom | label: mbimcli
  + rom | label: usb_net
  + rom | label: report_rom
  + rom | label: nic_router
  + rom | label: fs_rom
  + rom | label: libmbim.lib.so
  + rom | label: ld.lib.so
  + rom | label: libc.lib.so
  + rom | label: vfs
  + rom | label: vfs.lib.so
  + rom | label: vfs_import.lib.so
  + rom | label: vfs_pipe.lib.so
  + rom | label: libiconv.lib.so
  + rom | label: glib.lib.so
  + rom | label: ffi.lib.so
  + rom | label: zlib.lib.so
  + rom | label: mbimcli_cascaded_router.config
-
